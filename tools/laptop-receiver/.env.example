# Copy to .env (gitignored). HOST_UID/HOST_GID must match the user that
# owns ~/dev/perso, or received memos land unwritable.
HOST_UID=1000
HOST_GID=1000
DIKTAFON_HOSTNAME=laptop-sam
# Optional second lock on top of the tunnel's basic auth. If set, the
# address pasted into the app must end with `#<this value>`.
DIKTAFON_TOKEN=
# Defaults are ~/dev/perso and ~/diktafon-inbox.
#DIKTAFON_PROJECTS=/home/sam/dev/perso
#DIKTAFON_INBOX=/home/sam/diktafon-inbox
